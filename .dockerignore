# Docker ignore file for Zaura Health application
# Exclude unnecessary files from Docker build context

# Version control
.git/
.gitignore
.github/

# Documentation
*.md
docs/

# Development files
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# Local configuration
.env
.env.local
.env.development
.env.test
.env.production

# Test files
test_*.py
*_test.py
tests/
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
*~
.#*
\#*#
.*.swp
.*.swo

# Windows batch files (not needed in container)
*.bat

# Large datasets (should be downloaded or mounted)
data/
datasets/
*.csv
*.xlsx

# Local development database
*.db
zaura_health.db